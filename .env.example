# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production
FLASK_DEBUG=0

# Database (SQLite path relative to project or absolute)
DATABASE_URL=sqlite:///data/ritm.db

# Admin password (will be hashed on first run if ADMIN_PASSWORD is set)
# Use a strong password. Generate hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Or set plain password only for initial setup (then remove it)
# ADMIN_PASSWORD=your-strong-password

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Application
SITE_URL=https://your-domain.com
APPLICATIONS_ENABLED=false

# Rate limiting
RATELIMIT_DEFAULT=200 per day;50 per hour
RATELIMIT_STORAGE_URI=memory://

# Trusted proxy (comma-separated) if behind reverse proxy
# TRUSTED_PROXIES=127.0.0.1
